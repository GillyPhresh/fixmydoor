generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id                 String      @id @default(cuid())
  visitMode          String      @default("ONSITE")
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  quotations         Quotation[]
  @@index([customerId])
  @@index([propertyId])
  @@index([visitMode, createdAt])
  clientId           String?
  name               String
  phone              String
  email              String
  address            String
  city               String?
  country            String?
  timeZone           String?
  preferredContactMethod String?
  urgency            String?
  requestScope       String?
  currency           String?
  repairType         String
  preferredDate      String?
  message            String?
  status             String      @default("PENDING")
  customerToken      String?     @unique
  attachments        Attachment[]
  photos             String?
  dimensions         String?
  quantity           String?
  material           String?
  color              String?
  swingDirection     String?
  deliveryNeeded     String?
  installationNeeded String?
  budget             String?
  customerConsent    Boolean     @default(false)
  appointmentTime    String?
  quoteAmount        String?
  quoteNotes         String?
  invoiceStatus      String?
  paymentStatus      String?
  staffAssigned      String?
  adminNotes         String?
  reminderAt         String?
  reminderWindow     String?
  reminderNote       String?
  reminderSentAt     String?
  emailOptOut        Boolean     @default(false)
  statusHistory      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([reminderAt])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([clientId])
  @@index([customerToken])
}

model SmsDraft {
  id         String   @id @default(cuid())
  clientId   String?
  bookingId  String?
  clientName String
  phone      String
  message    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  sentAt     DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([clientId])
  @@index([bookingId])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Session {
  sid       String   @id
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  location  String?
  rating    Int      @default(5)
  quote     String
  status    String   @default("APPROVED")
  adminNotes String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
  @@index([status])
}

model ContentItem {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String?
  tag         String?
  image       String?
  accentImage String?
  items       String?
  bookingValue String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@index([sortOrder])
}

model Attachment {
  id String @id
  owner String?
  bookingId String?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  image Bytes
  createdAt DateTime @default(now())

  @@index([owner, createdAt])
  @@index([bookingId])
}

model Customer {
  id String @id @default(cuid())
  name String
  category String
  email String
  phone String
  preferredContactMethod String
  notes String
  createdAt DateTime @default(now())
  bookings Booking[]
  properties Property[]
  quotations Quotation[]
  @@index([name])
}

model Property {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  label String
  type String
  address String
  city String
  province String
  postalCode String
  country String
  accessInstructions String
  notes String
  bookings Booking[]
  quotations Quotation[]
  @@index([customerId])
}

model Quotation {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingId String?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  propertyId String?
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  description String
  notes String
  status String @default("DRAFT")
  currency String @default("CAD")
  createdAt DateTime @default(now())
  expiresOn String
  taxLabel String
  taxCents Int
  subtotalCents Int
  totalCents Int
  version Int @default(1)
  lines QuoteLine[]
  @@index([customerId])
  @@index([propertyId])
  @@index([bookingId])
}
model QuoteLine {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position Int
  kind String
  description String
  quantity Int
  unitCents Int
  @@unique([quotationId, position])
}
