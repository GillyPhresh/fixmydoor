generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  consultation RemoteConsultation?
  id                 String      @id @default(cuid())
  visitMode          String      @default("ONSITE")
  customerId         String?
  requestedByPortalAccountId String?
  requestedByPortalAccount PortalAccount? @relation(fields: [requestedByPortalAccountId], references: [id], onDelete: SetNull)
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  quotations         Quotation[]
  @@index([customerId])
  @@index([propertyId])
  @@index([visitMode, createdAt])
  clientId           String?
  name               String
  phone              String
  email              String
  address            String
  city               String?
  country            String?
  timeZone           String?
  preferredContactMethod String?
  urgency            String?
  requestScope       String?
  currency           String?
  repairType         String
  preferredDate      String?
  message            String?
  status             String      @default("PENDING")
  customerToken      String?     @unique
  attachments        Attachment[]
  photos             String?
  dimensions         String?
  quantity           String?
  material           String?
  color              String?
  swingDirection     String?
  deliveryNeeded     String?
  installationNeeded String?
  budget             String?
  customerConsent    Boolean     @default(false)
  appointmentTime    String?
  quoteAmount        String?
  quoteNotes         String?
  invoiceStatus      String?
  paymentStatus      String?
  staffAssigned      String?
  adminNotes         String?
  reminderAt         String?
  reminderWindow     String?
  reminderNote       String?
  reminderSentAt     String?
  emailOptOut        Boolean     @default(false)
  statusHistory      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([reminderAt])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([clientId])
  @@index([customerToken])
  @@index([requestedByPortalAccountId])
}

model SmsDraft {
  id         String   @id @default(cuid())
  clientId   String?
  bookingId  String?
  clientName String
  phone      String
  message    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  sentAt     DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([clientId])
  @@index([bookingId])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Session {
  sid       String   @id
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  location  String?
  rating    Int      @default(5)
  quote     String
  status    String   @default("APPROVED")
  adminNotes String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
  @@index([status])
}

model ContentItem {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String?
  tag         String?
  image       String?
  accentImage String?
  items       String?
  bookingValue String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@index([sortOrder])
}

model Attachment {
  id String @id
  owner String?
  bookingId String?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  image Bytes
  createdAt DateTime @default(now())

  @@index([owner, createdAt])
  @@index([bookingId])
}

model Customer {
  id String @id @default(cuid())
  name String
  category String
  email String
  phone String
  preferredContactMethod String
  notes String
  createdAt DateTime @default(now())
  bookings Booking[]
  properties Property[]
  quotations Quotation[]
  organization Organization?
  portalAccounts PortalAccount[]
  invitations PortalInvitation[]
  consents CommunicationConsent[]
  @@index([name])
}

model Property {
  agreements MaintenanceAgreement[]
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  label String
  type String
  address String
  city String
  province String
  postalCode String
  country String
  accessInstructions String
  notes String
  bookings Booking[]
  quotations Quotation[]
  @@index([customerId])
}

model Quotation {
  consultation RemoteConsultation?
  occurrence MaintenanceOccurrence?
  invoice Invoice?
  job Job?
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingId String?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  propertyId String?
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  description String
  notes String
  status String @default("DRAFT")
  currency String @default("CAD")
  createdAt DateTime @default(now())
  expiresOn String
  taxLabel String
  taxCents Int
  subtotalCents Int
  totalCents Int
  version Int @default(1)
  lines QuoteLine[]
  @@index([customerId])
  @@index([propertyId])
  @@index([bookingId])
}
model QuoteLine {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position Int
  kind String
  description String
  quantity Int
  unitCents Int
  @@unique([quotationId, position])
}

model Technician {
  id String @id @default(cuid())
  name String
  phone String
  email String
  province String
  city String
  experience String
  notes String
  available Boolean @default(false)
  status String @default("APPLICANT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grants ServiceGrant[]
  jobs Job[]
  portalAccount PortalAccount?
  invitations PortalInvitation[]
  membership TechnicianMembership?
}
model ServiceGrant {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields:[technicianId],references:[id],onDelete:Restrict)
  category String
  province String
  city String
  evidence String
  expiresOn String
  reviewer String
  reviewedAt DateTime @default(now())
  @@unique([technicianId,category,province,city])
}
model Job {
  id String @id @default(cuid())
  reference String @unique
  photos JobPhoto[]
  quoteId String @unique
  quote Quotation @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  agreement String
  category String
  province String
  city String
  location String
  description String
  status String @default("DRAFT")
  technicianId String?
  technician Technician? @relation(fields:[technicianId],references:[id],onDelete:Restrict)
  startsAt DateTime?
  endsAt DateTime?
  internalNotes String @default("")
  workPerformed String @default("")
  labourMinutes Int @default(0)
  materials String @default("")
  customerSummary String @default("")
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  technicianResponse String @default("PENDING")
  technicianResponseAt DateTime?
  history JobEvent[]
  @@index([technicianId,status,startsAt])
}
model JobPhoto {
  id String @id @default(cuid())
  jobId String
  job Job @relation(fields:[jobId],references:[id],onDelete:Restrict)
  kind String
  image Bytes
  createdAt DateTime @default(now())
  @@index([jobId])
}
model JobEvent {
  id String @id @default(cuid())
  jobId String
  job Job @relation(fields:[jobId],references:[id],onDelete:Restrict)
  status String
  technicianId String?
  startsAt DateTime?
  endsAt DateTime?
  actor String
  createdAt DateTime @default(now())
  @@index([jobId,createdAt])
}

model Invoice {
  gstRegistration String @default("")
  qstRegistration String @default("")
  gstCents Int @default(0)
  qstCents Int @default(0)
  paidCents Int @default(0)
  payments InvoicePayment[]
  attempts PaymentAttempt[]
  id String @id @default(cuid())
  number String @unique
  quoteId String @unique
  quote Quotation @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  customerName String
  description String
  lines String
  subtotalCents Int
  taxLabel String
  taxCents Int
  totalCents Int
  currency String @default("CAD")
  status String @default("DRAFT")
  dueOn String
  issuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
}

model InvoicePayment {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Restrict)
  method String
  reference String
  cents Int
  actor String
  createdAt DateTime @default(now())
  @@unique([method, reference])
  @@index([invoiceId])
}

model MaintenanceAgreement {
  id String @id @default(cuid())
  propertyId String
  property Property @relation(fields:[propertyId],references:[id],onDelete:Restrict)
  scope String
  startOn String
  endOn String
  months Int
  cents Int
  status String @default("ACTIVE")
  staff String
  notes String
  authorization String
  createdAt DateTime @default(now())
  occurrences MaintenanceOccurrence[]
  @@index([propertyId,status])
}
model MaintenanceOccurrence {
  id String @id @default(cuid())
  agreementId String
  agreement MaintenanceAgreement @relation(fields:[agreementId],references:[id],onDelete:Restrict)
  period Int
  dueOn String
  quoteId String @unique
  quote Quotation @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  @@unique([agreementId,period])
}

model PaymentAttempt {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  requestKey String
  provider String
  cents Int
  refundedCents Int @default(0)
  currency String @default("CAD")
  status String @default("PENDING")
  events PaymentEvent[]
  @@unique([invoiceId,requestKey])
}
model PaymentEvent {
  id String @id
  attemptId String
  attempt PaymentAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
  kind String
  cents Int
  createdAt DateTime @default(now())
}

model RemoteConsultation {
  bookingId String @id
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
  quoteId String @unique
  quote Quotation @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  serviceType String
  availability String
  durationMinutes Int
  requiresPayment Boolean
  scheduledAt DateTime
  outcome String @default("")
  completedAt DateTime?
}

// Portal identities are separate from customer records and admin credentials.
// A customer or technician may access only the records linked to that identity.
model PortalAccount {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  kind String
  status String @default("ACTIVE")
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technicianId String? @unique
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  organizationMemberships OrganizationMembership[]
  requestedBookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  @@index([customerId, status])
  @@index([kind, status])
}

model Organization {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  externalId String? @unique
  name String
  email String
  phone String
  status String @default("ACTIVE")
  memberships OrganizationMembership[]
  invitations PortalInvitation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMembership {
  id String @id @default(cuid())
  accountId String
  account PortalAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role String
  status String @default("ACTIVE")
  invitedBy String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@unique([accountId, organizationId])
  @@index([organizationId, status, role])
}

model PortalInvitation {
  id String @id @default(cuid())
  email String
  kind String
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technicianId String?
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationRole String?
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([email, expiresAt])
  @@index([customerId, acceptedAt])
  @@index([technicianId, acceptedAt])
  @@index([organizationId, acceptedAt])
}

model CommunicationConsent {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  channel String
  purpose String
  granted Boolean
  source String
  capturedAt DateTime @default(now())
  @@index([customerId, purpose, channel, capturedAt])
}

model AuditEvent {
  id String @id @default(cuid())
  actorType String
  actorId String
  action String
  entityType String
  entityId String
  metadata String @default("{}")
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
}

model AIInteraction {
  id String @id @default(cuid())
  purpose String
  entityType String
  entityId String
  provider String
  output String
  reviewedAt DateTime?
  reviewedBy String?
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}

model TechnicianMembership {
  id String @id @default(cuid())
  technicianId String @unique
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  plan String
  status String @default("INACTIVE")
  billingPeriod String @default("NONE")
  startsOn String?
  renewsOn String?
  includedBenefits String @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events TechnicianMembershipEvent[]
}

model TechnicianMembershipEvent {
  id String @id
  membershipId String
  membership TechnicianMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  action String
  actor String
  details String @default("")
  createdAt DateTime @default(now())
  @@index([membershipId, createdAt])
}
