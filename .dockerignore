# Keep the Railway/Docker image clean and avoid shipping secrets.
node_modules
dist
.git
.env
.env.*
**/.env
**/.env.*
*.log
dev-server.log

# Local databases should not be copied into the image.
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/prisma
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3

# Editor and OS files.
.vscode
.idea
Thumbs.db
.DS_Store

# Runtime/debug artifacts.
.manus-logs
coverage
.cache
.webdev
uploads
**/uploads
data
**/data
runtime
**/runtime
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db-wal
**/*.db-shm
*.bak
*.backup
*.tmp
*.temp
*.local
**/*.bak
**/*.backup
**/*.tmp
**/*.temp
**/*.local
dist-check
dist-server-check
coverage
.manus-logs

# Synthetic browser output and traces must never ship
test-results
playwright-report
**/test-results
**/playwright-report

**/node_modules
**/.vite

# Portable backup envelopes and scratch files never enter the image.
**/*.fmd
**/.fmd-backup-*
