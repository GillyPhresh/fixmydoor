# Production Environment Variables
# Copy this to .env for production deployment

# Database
DATABASE_URL="file:./prisma/prod.db"

# Security (REQUIRED - Generate strong random secrets)
SESSION_SECRET="your-very-secure-random-session-secret-here-minimum-32-characters"

# Admin User Creation (Optional - only set if you need to create initial admin)
# CREATE_DEFAULT_ADMIN="true"
# DEFAULT_ADMIN_USERNAME="admin"
# DEFAULT_ADMIN_PASSWORD="YourSecurePassword123!"

# Environment
NODE_ENV="production"

# Optional: Analytics (if you add analytics later)
# VITE_ANALYTICS_ENDPOINT=""
# VITE_ANALYTICS_WEBSITE_ID=""

# Email
# Recommended for Railway production: Resend over HTTPS.
# After CanSpace approves the domain, add the domain in Resend and copy the DNS
# records Resend gives you into CanSpace before using a @fixmydoor.ca sender.
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM_EMAIL="FixMyDoor <bookings@fixmydoor.ca>"
#
# Fallback SMTP option:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# FROM_EMAIL="FixMyDoor <info.fixmydoor@gmail.com>"
# BUSINESS_EMAIL="info.fixmydoor@gmail.com"
# ADMIN_EMAIL="info.fixmydoor@gmail.com"

# Public website URL for SEO, sitemap, booking tracking links, and email logo links.
# Use the Railway URL before the domain is approved, then change to the final domain.
# PUBLIC_SITE_URL="https://fixmydoorservices.up.railway.app"
# PUBLIC_SITE_URL="https://fixmydoor.ca"

# Admin URL for email links.
# ADMIN_URL="https://fixmydoorservices.up.railway.app/admin"
# ADMIN_URL="https://fixmydoor.ca/admin"

# Optional Railway fallback. The app can use this if PUBLIC_SITE_URL is not set,
# but PUBLIC_SITE_URL is still recommended after the final domain is connected.
# RAILWAY_PUBLIC_DOMAIN="fixmydoorservices.up.railway.app"
